      playcur: 'From current', playcurT: 'Present from selected slide (Shift+F5)', play: '▶ Present', playT: 'Present from start (F5)',
      presenter: 'Presenter', notes: 'Notes', thisPage: 'Slide', total: 'Total', fragN: 'Frag ', noFrags: 'No fragments',
      nextFrag: 'Next state · frag ', nextSlide: 'Next slide · final', lastPage: 'Last page', firstPage: 'First page',
      noNotes: '(no notes)', nextCap: 'Next state', nextCapFinal: 'Next slide · final', endMark: '— END —',
      prevT: 'Previous (← / PgUp)', nextT: 'Next (→ / Space)', timerT: 'Total time (T to pause)',
      rehearseT: 'Rehearse (R)', laserT: 'Laser pointer (L)', blackT: 'Black screen (B)', overviewT: 'Overview (G)',
      drawerT: 'Presenter drawer (S)', preswinT: 'Presenter window (needs http)', fullscreenT: 'Fullscreen (F)', helpT: 'Help (?)',
      helpTitle: 'Keyboard help', numEnter: 'Number + Enter',
