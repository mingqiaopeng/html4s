      hRemote: 'Connect presenter remote (experimental; most remotes are keyboard devices)', hFull: 'Toggle fullscreen', hEsc: 'Exit overlay / fullscreen',
      drawerOn: 'Presenter drawer opened (same-screen practice)', drawerOff: 'Presenter drawer closed',
