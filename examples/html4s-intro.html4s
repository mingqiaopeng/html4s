<!-- h4s 播放器：构建期(h4s-build)内联为单文件；开发期相对路径 -->
<script>
/*!
 * h4s-core — html4s 播放器运行时 v0.5.0（转场特效 · 增量编辑 · 声明式图表）
 * ------------------------------------------------
 * 单文件、零依赖、无构建。任何遵循 html4s 约定的 HTML 页面引入本文件
 * 即进入播放器模式；页面没有幻灯片结构时保持文档模式不受影响。
 *
 * 支持的页面约定（适配器）:
 *   - 规范元素: <h4s-deck> / <h4s-slide> / <h4s-notes hidden>
 *   - 通用约定: body/deck/.slides 容器下的直接 <section> 子元素或 .slide 元素
 *   - 碎片: [data-h4s-frag] 或 reveal.js 兼容的 .fragment
 *   - 清单: <script type="application/h4s+json">（可选，缺省用内置默认值）
 *
 * 规范: ../ARCHITECTURE.md §3
 */
(function () {
  'use strict';
  if (window.__H4S_LOADED__) return;
  window.__H4S_LOADED__ = true;

  var VERSION = '0.5.0';
  var PV_STALE = null; /* 清单 playerVersion ≠ 本播放器版本 → 旧版内嵌（build 注入指纹后检测） */

  /* ================================================================
   * 工具
   * ================================================================ */
  var clamp = function (v, a, b) { return Math.max(a, Math.min(b, v)); };
  var sleep = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function el(tag, cls, html) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (html != null) e.innerHTML = html;
    return e;
  }
  function esc(s) {
    return String(s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  function fmt(sec) {
    sec = Math.max(0, Math.floor(sec));
    var m = Math.floor(sec / 60), s = sec % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  }
  function on(target, ev, fn, opt) { target.addEventListener(ev, fn, opt); }
  /* 转发壳级快捷键给桌面壳（WebView2 宿主下有效；浏览器中无 chrome.webview，静默跳过） */
  function shellAction(a, data) {
    try {
      if (window.chrome && window.chrome.webview) {
        var msg = data ? { h4sShell: a, data: data } : { h4sShell: a };
        window.chrome.webview.postMessage(JSON.stringify(msg));
      }
    } catch (e) {}
  }

  /* ---- UI 多语言（i18n）：壳语言覆盖（localStorage h4s-lang-override）>
     清单 meta.lang > 浏览器语言 ---- */
  var UI_STR = {
    zh: { open: '打开', openT: '打开本地 .html4s 文件 (Ctrl+O)', url: '网址', urlT: '打开网址播放 (Ctrl+L)',
      toLight: '☀ 浅色', toDark: '🌙 深色', themeT: '深色/浅色切换',
      playcur: '从当前放映', playcurT: '从当前选中页放映 (Shift+F5)', play: '▶ 放映', playT: '从头放映 (F5)',
      presenter: '演讲者视图', notes: '备注', thisPage: '本页', total: '总计', fragN: '碎片 ', noFrags: '无碎片',
      nextFrag: '下一状态 · 碎片 ', nextSlide: '下一页 · 最终状态', lastPage: '已是最后一页', firstPage: '已是第一页',
      noNotes: '（本页无备注）', nextCap: '下一状态', nextCapFinal: '下一页 · 最终状态', endMark: '— END —',
      tele: '提词', teleT: '提词模式：备注大字号跟随', npEnd: '已是最后一段', npStart: '已是第一段', hNote: '备注段落推进（提词，不动幻灯片）',
      prevT: '上一页 (← / PgUp)', nextT: '下一页 (→ / 空格)', timerT: '总时长 (T 暂停)',
      rehearseT: '排练录制 (R)', laserT: '激光笔 (L)', blackT: '黑屏 (B)', overviewT: '总览 (G)',
      drawerT: '演讲者视图 (S)', preswinT: '独立演讲者窗口（需 http 访问）', fullscreenT: '全屏 (F)', helpT: '帮助 (?)',
      helpTitle: '键盘帮助', numEnter: '数字 + Enter',
      hNext: '下一步（碎片内推进 → 翻页）', hPrev: '上一步', hHome: '首页 / 末页', hNum: '跳页（显示最终碎片状态）',
      hBlack: '黑屏 / 白屏', hGrid: '总览网格 / 演讲者抽屉', hTime: '计时暂停 / 排练录制', hLaser: '激光笔',
      hRemote: '连接翻页笔（实验性；多数翻页笔为键盘设备，直接可用）', hFull: '全屏切换', hEsc: '退出浮层 / 全屏',
      drawerOn: '演讲者抽屉已开启（同屏练习模式）', drawerOff: '演讲者抽屉已关闭',
      rehearseStart: '排练开始（R 结束）', rehearseEnd: '排练结束：共 {0}，明细已写回 .timings.json',
      paused: '计时已暂停', resumed: '计时继续', numRange: '页码超出范围 1-{0}',
      editHint: '文字微调模式：单击预览中的文字直接修改，Esc 退出', editOff: '文字微调模式已关闭',
      edited: '✓ 已修改（第 {0} 页）', editedLack: ' · ⚠ 子集缺字: {0}（导出后该处回退系统字体）',
      exporting: '正在写回源文件…', writeBackOk: '已写回源文件 ✓ 建议运行 h4s-build --subset 重建以更新字体子集',
      writeBackFail: '写回失败（{0}），已改为导出下载', exported: '已导出包含文字修改的 .html4s',
      snapFail: '快照不可用（deck 过早修改？）',
      stalePlayer: '检测到旧版内嵌播放器（{0} → {1}）：功能可能缺失，建议 h4s-build 重建',
      webHint: '未检测到幻灯片结构 · <b>F5</b> 网页放映（全屏按屏翻页） · Esc 退出',
      webBadge: '{0} / {1} 屏 · → 翻页 · Esc 退出', webToast: '网页放映：方向键/空格按屏翻页，Esc 退出',
      presPrev: '◀ 上一页', presNext: '下一页 ▶', presBlack: '黑屏 B', presWhite: '白屏 W', presGrid: '总览 G',
      presTitle: '[演讲者] ',
      presWarnNoStage: '未检测到舞台窗口（BroadcastChannel 需 http:// 访问），已切换本地练习模式',
      presWarnLost: '信号中断：请确认舞台窗口仍开着',
      kioskUnlock: 'kiosk 已解锁（Ctrl+Alt+Q 重新锁定）',
      popupBlocked: '弹窗被浏览器拦截，请允许弹窗后重试', presWinOpened: '演讲者窗口已打开（双屏时拖到副屏）',
      remoteUnsupported: '此环境不支持 WebHID（需 Chrome/Edge 与安全上下文）', remoteConnected: '翻页笔已连接: ',
      remoteFail: '翻页笔连接失败' },
    en: { open: 'Open', openT: 'Open local .html4s file (Ctrl+O)', url: 'URL', urlT: 'Play from URL (Ctrl+L)',
      toLight: '☀ Light', toDark: '🌙 Dark', themeT: 'Toggle light/dark',
      playcur: 'From current', playcurT: 'Present from selected slide (Shift+F5)', play: '▶ Present', playT: 'Present from start (F5)',
      presenter: 'Presenter', notes: 'Notes', thisPage: 'Slide', total: 'Total', fragN: 'Frag ', noFrags: 'No fragments',
      nextFrag: 'Next state · frag ', nextSlide: 'Next slide · final', lastPage: 'Last page', firstPage: 'First page',
      noNotes: '(no notes)', nextCap: 'Next state', nextCapFinal: 'Next slide · final', endMark: '— END —',
      tele: 'Tele', teleT: 'Teleprompter: large notes follow', npEnd: 'Last paragraph', npStart: 'First paragraph', hNote: 'Notes paragraph step (teleprompter, slides stay)',
      prevT: 'Previous (← / PgUp)', nextT: 'Next (→ / Space)', timerT: 'Total time (T to pause)',
      rehearseT: 'Rehearse (R)', laserT: 'Laser pointer (L)', blackT: 'Black screen (B)', overviewT: 'Overview (G)',
      drawerT: 'Presenter drawer (S)', preswinT: 'Presenter window (needs http)', fullscreenT: 'Fullscreen (F)', helpT: 'Help (?)',
      helpTitle: 'Keyboard help', numEnter: 'Number + Enter',
      hNext: 'Next step (fragments first, then slides)', hPrev: 'Previous step', hHome: 'First / last slide', hNum: 'Jump to slide (final fragment state)',
      hBlack: 'Black / white screen', hGrid: 'Overview grid / presenter drawer', hTime: 'Pause timer / rehearse', hLaser: 'Laser pointer',
      hRemote: 'Connect presenter remote (experimental; most remotes are keyboard devices)', hFull: 'Toggle fullscreen', hEsc: 'Exit overlay / fullscreen',
      drawerOn: 'Presenter drawer opened (same-screen practice)', drawerOff: 'Presenter drawer closed',
      rehearseStart: 'Rehearsal started (R to stop)', rehearseEnd: 'Rehearsal done: {0}, timings written to .timings.json',
      paused: 'Timer paused', resumed: 'Timer resumed', numRange: 'Slide number out of range 1-{0}',
      editHint: 'Text touch-up: click text in the preview to edit, Esc to exit', editOff: 'Text touch-up off',
      edited: '✓ Modified (slide {0})', editedLack: ' · ⚠ subset missing: {0} (falls back to system font after export)',
      exporting: 'Writing back to source file…', writeBackOk: 'Written back to source ✓ run h4s-build --subset to refresh font subset',
      writeBackFail: 'Write-back failed ({0}), exported as download instead', exported: 'Exported .html4s with text edits',
      snapFail: 'Snapshot unavailable (deck modified too early?)',
      stalePlayer: 'Stale embedded player ({0} → {1}): features may be missing, rebuild with h4s-build',
      webHint: 'No slide structure found · <b>F5</b> web present (fullscreen page-by-page) · Esc exits',
      webBadge: '{0} / {1} screens · → next · Esc exits', webToast: 'Web present: arrows/space page through, Esc exits',
      presPrev: '◀ Prev', presNext: 'Next ▶', presBlack: 'Black B', presWhite: 'White W', presGrid: 'Grid G',
      presTitle: '[Presenter] ',
      presWarnNoStage: 'No stage window detected (BroadcastChannel needs http://), switched to local practice mode',
      presWarnLost: 'Signal lost: make sure the stage window is still open',
      kioskUnlock: 'kiosk unlocked (Ctrl+Alt+Q to re-lock)',
      popupBlocked: 'Popup blocked — allow popups and retry', presWinOpened: 'Presenter window opened (drag to second screen)',
      remoteUnsupported: 'WebHID not supported here (needs Chrome/Edge and a secure context)', remoteConnected: 'Remote connected: ',
      remoteFail: 'Remote connection failed' }
  };
  var UILANG = 'zh';
  try {
    var _ovr = localStorage.getItem('h4s-lang-override'); /* 壳设置对话框写入 */
    var _mlang = ((JSON.parse(($('script[type="application/h4s+json"]') || { textContent: '{}' }).textContent) || {}).meta || {}).lang || '';
    var _nav = (navigator.language || 'zh');
    UILANG = (_ovr === 'zh' || _ovr === 'en') ? _ovr : (/^zh/i.test(_mlang || _nav) ? 'zh' : 'en');
  } catch (err) {}
  function t(k) { return (UI_STR[UILANG] && UI_STR[UILANG][k]) || UI_STR.zh[k] || k; }
  /* 占位符版本：t 的键值里 {0}/{1} 依次替换为后续参数 */
  function tf(k) {
    var s = t(k);
    for (var i = 1; i < arguments.length; i++) s = s.split('{' + (i - 1) + '}').join(String(arguments[i]));
    return s;
  }

  /* 浏览模式 UI 深浅色 */
  var uiTheme = 'dark';
  function applyUiTheme(t) {
    uiTheme = t;
    document.body.setAttribute('data-ui', t);
    try { localStorage.setItem('h4s-ui-theme', t); } catch (err) {}
    shellAction('theme', t);  /* 桌面壳同步标题栏深浅色 */
  }
  function updateThemeBtn() {
    if (!browseBar) return;
    var b = browseBar.querySelector('[data-bact="theme"]');
    if (b) b.textContent = uiTheme === 'light' ? t('toDark') : t('toLight');
  }
  try { uiTheme = localStorage.getItem('h4s-ui-theme') || 'dark'; } catch (err) {}

  /* 壳握手：postMessage 'hello' → 壳回 'hello' 才认定 shell 可用。
     应用内浏览器等 WebView2 宿主虽存在 chrome.webview 但不处理 h4sShell —— 按钮保持隐藏。 */
  var shellReady = false;
  var fileInput = null;
  var pendingSave = null; /* 壳内导出写回：等待 h4sSaved 回执期间的导出 HTML
    （此前从未声明赋值——回执分支是死代码，写回失败时用户无从得知） */
  try {
    if (window.chrome && window.chrome.webview) {
      window.chrome.webview.addEventListener('message', function (e) {
        try {
          var m = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
          if (m && m.h4sSaved !== undefined && pendingSave) {
            var out = pendingSave; pendingSave = null;
            if (m.h4sSaved) {
              toast(t('writeBackOk'));
            } else {
              toast(tf('writeBackFail', m.reason || '-'));
              downloadEdited(out, true); /* 失败提示已在前面，下载不再抢 toast */
            }
            return;
          }
          if (m && m.h4sShellHello && !shellReady) {
            shellReady = true;
            shellAction('theme', uiTheme);  /* 握手即同步当前主题（localStorage 恢复的场景） */
          }
        } catch (err) {}
      });
