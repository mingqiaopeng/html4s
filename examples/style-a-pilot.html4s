    "stage": { "width": 1920, "height": 1080, "fit": "contain", "background": "transparent" },
    "defaults": {
      "transition": { "name": "slide", "duration": 450 },
      "fragment": { "effect": "fade-up", "delay": 150 },
      "autoslide": 0,
      "loop": false,
      "progress": true,
      "slideNumber": true
    },
